{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug PDAF_offline (with GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tutorial/offline_2D_serial/PDAF_offline.exe",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/tutorial/offline_2D_serial",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "preLaunchTask": "Build Tutorial Offline",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set language to Fortran",
                    "text": "-gdb-set language fortran",
                    "ignoreFailures": true
                }
            ]
        }
    ]
} 